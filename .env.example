# Copy this file to .env and set real values for your environment.
# .env is gitignored — never commit real API URLs/secrets to the repo.

# Base URL of the ZTP backend API (see src/js/core/api-config.js)
# In production (e.g. Vercel), set: VITE_API_URL=https://ztp-backend.onrender.com
VITE_API_URL=http://localhost:8080


# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit real secrets or URLs to the repo.

# ─── Backend API URL ────────────────────────────────────────────────────────
# The full base URL of the backend API (without trailing slash).
# api-config.js will append /api automatically if not already present.
#
# Production (Vercel → cPanel Laravel backend):
#   VITE_API_URL=http://fancy-onyx-otter.37-27-228-109.cpanel.site/public/api
#
# Local dev against Laravel (port 8000):
#   VITE_API_URL=http://localhost:8000
#
# Local dev against Java Spring Boot (port 8080):
#   VITE_API_URL=http://localhost:8080

VITE_API_URL=http://localhost:8000

# ─── Backend Origin (for CSRF cookie bootstrap) ─────────────────────────────
# Only needed if VITE_API_URL alone doesn't resolve the correct origin.
# Leave blank in most cases — api-config.js derives it from VITE_API_URL.
#
# Production example:
#   VITE_BACKEND_ORIGIN=http://fancy-onyx-otter.37-27-228-109.cpanel.site

VITE_BACKEND_ORIGIN=

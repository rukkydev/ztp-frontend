{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fordcapital.live/public/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fordcapital.live/public/uploads/:path*"
    },
    { "source": "/(.*)\\.html", "destination": "/$1.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
